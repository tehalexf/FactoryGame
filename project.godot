; DEEP FOUNDRY — Godot project file.
;
; Godot is a renderer and input layer only (docs/adr/0001). All game logic
; lives in res://sim/, outside the node tree. See CLAUDE.md.

config_version=5

[application]

config/name="DEEP FOUNDRY"
config/description="Dieselpunk first-person factory-defense game."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[rendering]

renderer/rendering_method="forward_plus"
