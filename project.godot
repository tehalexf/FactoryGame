; DEEP FOUNDRY — Godot project file.
;
; Godot is a renderer and input layer only (docs/adr/0001). All game logic
; lives in res://sim/, outside the node tree. See CLAUDE.md.

config_version=5

[application]

config/name="DEEP FOUNDRY"
config/description="Dieselpunk first-person factory-defense game."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

; The test runner reads this log to notice a test method aborted halfway by a
; GDScript runtime error — the only report the engine makes of one. It is on by
; default on desktop; stated here so the suite does not lean on that default.
; tests/run_tests.gd fails the whole suite if the log turns out not to be live.
file_logging/enable_file_logging=true

[rendering]

renderer/rendering_method="forward_plus"
