# ── Licensed third-party assets — MUST NOT be committed ───────────────────
# Purchased and license-restricted assets prohibit redistribution. This repo
# is public. Anything under here is pulled in locally; see docs/ASSETS.md.
/assets_licensed/
# ...except Godot's marker telling the engine not to scan it. It must be in git:
# without it a fresh clone points the importer at gigabytes of third-party Unity
# projects and WAV libraries. It is empty, and the licence guard allows it only
# while it stays empty.
!/assets_licensed/.gdignore

# Godot
.godot/
/android/
*.translation

# `export_presets.cfg` is deliberately NOT ignored, which is the opposite of
# Godot's own template. Here it is not a developer's private preference: its
# `include_filter` is the only thing that puts the runtime-loaded assets and the
# whole of `content/` into the PCK, and `tools/release/build_windows.sh` cannot run
# without it. See docs/RELEASING.md and the comments in the file itself.

# Generated art pipeline output (regenerable; large)
/tools/aigen/models/
/tools/aigen/output/
/tools/comfyui/

# Build artifacts
/build/
/bin/
*.so
*.dll
*.dylib
*.o
*.obj

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# aigen venv (created by tools/aigen/setup.sh on top of the system torch)
/tools/aigen/.venv/

# Agent worktrees — never part of the repo
.claude/worktrees/
